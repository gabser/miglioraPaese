{
  "name": "@migliorapaese/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/server.js",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:verify": "node scripts/migrate.js verify",
    "migrations:verify-history": "node scripts/verify-migration-history.js",
    "migrations:verify": "node scripts/verify-migration-manifest.js",
    "seed:local": "node scripts/seed.js local",
    "start": "NODE_ENV=production node src/server.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "devDependencies": {
    "node-pg-migrate": "8.0.4"
  }
}
